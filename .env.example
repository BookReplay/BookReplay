# Planned first release; use a published version tag or immutable image digest.
# Until publication, use compose.dev.yaml to build from source (see README).
BOOKREPLAY_IMAGE=ghcr.io/loukag/bookreplay:v0.1.0

# REQUIRED: replace the empty value with `openssl rand -hex 32` output.
# Use URL-safe characters; arbitrary passwords must be percent-encoded in the URL.
POSTGRES_PASSWORD=
# Compose expands POSTGRES_PASSWORD here. Keep database/user/host in sync with Compose.
DATABASE_URL=postgresql://bookreplay:${POSTGRES_PASSWORD}@postgres:5432/bookreplay

# Optional contact email for the Open Library User-Agent; empty is supported.
OPEN_LIBRARY_CONTACT_EMAIL=
# Optional server-only key enabling Google Books fallback and manual search.
GOOGLE_BOOKS_API_KEY=
# Exactly true or false. Use false for localhost/SSH-tunnel HTTP, true for HTTPS.
SESSION_COOKIE_SECURE=false
# Exact browser origin, without a trailing slash. Remote access requires HTTPS.
APP_ORIGIN=http://localhost:2665
# REQUIRED for first setup: a separate `openssl rand -hex 32` value.
# Empty disables registration. Remove after creating the owner and recreate the app.
SETUP_SECRET=
# Rust tracing filter. API default: bookreplay_api=info.
RUST_LOG=bookreplay_api=info
